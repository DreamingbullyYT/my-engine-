[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_left = 0.07
anchor_top = 0.08
anchor_right = 0.93
anchor_bottom = 0.92
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("PanelBackground")

[node name="Scroll" type="ScrollContainer" parent="Panel"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 1

[node name="Content" type="VBoxContainer" parent="Panel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1
theme_override_constants/separation = 9

[node name="Title" type="Label" parent="Panel/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.95, 1, 1)
theme_override_font_sizes/font_size = 30
