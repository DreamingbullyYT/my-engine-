theme_override_font_sizes/font_size = 16
text = "M2 · Native C++ + M3 · External GDScript + M4 · .dmod"
horizontal_alignment = 1

[node name="EngineVersion" type="Label" parent="Panel/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.88, 1)
theme_override_font_sizes/font_size = 13
