; Engine: official Godot 4.7.2-stable
; M1 foundation only. Gameplay modules are introduced incrementally.

config_version=5

[application]

config/name="Dream Engine"
config/description="A modular mobile colony and space exploration game."
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

AppLifecycle="*res://core/app_lifecycle.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.025, 0.05, 1)
