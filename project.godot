; Engine: official Godot 4.7.2-stable
; Official Godot remains unmodified. Gameplay lives in modular GDScript domains.

config_version=5

[application]

config/name="Dream Engine"
config/icon="res://icon.svg"
config/description="An Android-first, modular colony management game with future space expansion."
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

AppLifecycle="*res://core/app_lifecycle.gd"
ColonySimulation="*res://colony/colony_simulation.gd"
RocketFlight="*res://vehicles/rocket_flight.gd"
SaveService="*res://saves/save_service.gd"
ModRuntime="*res://mods/mod_runtime.gd"
ModPackageManager="*res://mods/mod_package_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.015, 0.025, 0.05, 1)
