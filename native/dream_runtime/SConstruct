#!/usr/bin/env python3

import os

from SCons.Script import ARGUMENTS, Default, Environment, Exit, Glob, Help, SConscript, Variables

LIBRARY_NAME = "dream_runtime"
GODOT_CPP_API_VERSION = "4.7"

customs = []
local_env = Environment(tools=["default"], PLATFORM="")
options = Variables(customs, ARGUMENTS)
options.Update(local_env)
Help(options.GenerateHelpText(local_env))

if not os.path.isfile("godot-cpp/SConstruct"):
    print("godot-cpp is missing. Run .github/scripts/build_dream_runtime.sh first.")
    Exit(1)

env = local_env.Clone()
env = SConscript(
    "godot-cpp/SConstruct",
    {
        "api_version": GODOT_CPP_API_VERSION,
        "env": env,
        "customs": customs,
    },
)

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
library_filename = (
    env.subst("$SHLIBPREFIX")
    + LIBRARY_NAME
    + suffix
    + env.subst("$SHLIBSUFFIX")
)

build_dir = os.path.join("build", env["platform"])
library = env.SharedLibrary(
    os.path.join(build_dir, library_filename),
    source=sources,
)
installed_library = env.Install(
    os.path.join("bin", env["platform"]),
    library,
)

Default(installed_library)
