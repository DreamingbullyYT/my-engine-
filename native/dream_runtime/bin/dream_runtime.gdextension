[configuration]

entry_symbol = "dream_runtime_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

android.arm64.single.debug = "./android/libdream_runtime.android.template_debug.arm64.so"
android.arm64.single.release = "./android/libdream_runtime.android.template_release.arm64.so"
linux.x86_64.single.debug = "./linux/libdream_runtime.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "./linux/libdream_runtime.linux.template_release.x86_64.so"
